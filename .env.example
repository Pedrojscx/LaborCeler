# Variáveis de ambiente do Portal de Certificação em Metodologias Ágeis.
# Todas são opcionais na feature 001: sem um arquivo .env, valem os padrões do docker-compose.yml.
# Para personalizar, copie para .env (que não é versionado) e altere só o que precisar.

# Porta do portal, publicada no host com o mesmo número.
PORT=3000

# Endereço público do portal (usado no QR Code a partir da feature 005).
# Se não for definida, vale http://localhost:${PORT}.
# PUBLIC_BASE_URL=http://localhost:3000

# Conexão do app com o banco. Precisa bater com POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB.
DATABASE_URL=postgres://portal:portal@db:5432/bdcertificacao

# Usuário, senha e banco criados na primeira subida (volume vazio). Valores de desenvolvimento.
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=bdcertificacao

# Segredo de assinatura da sessão (feature 002, FR-029). Opcional: sem ele, o app gera um segredo
# na primeira subida e o guarda no volume segredo_sessao ("docker compose down -v" o apaga, e as
# sessões abertas deixam de valer). Se definido, precisa de 32 caracteres ou mais.
JWT_SECRET=
